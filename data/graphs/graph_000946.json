      "post_type": "reaction"
    },
    {
      "post_id": "500447398733152256",
      "text": "@khamenei_ir  LOL\nYou are a country of intolerance and lies",
      "timestamp": "Sat Aug 16 01:02:12 +0000 2014",
      "parent_id": 5.003504601221366e+17,
      "post_type": "reaction"
    },
    {
      "post_id": "501135827460968448",
      "text": ". @Bizzznisss There is a kernel of truth to @khamenei_ir's tweet because the US #humanrights record is far from good.",
